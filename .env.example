# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Required for live mode (server-side only; never sent to the browser).
# Without it, MirrorMatch runs in mock mode: the full flow works, previews are placeholders.
YOUCAM_API_KEY=

# Optional: OpenAI-compatible endpoint used ONLY to reword shopper-facing text.
# All decisions (matching, policy, exchange) are deterministic code. Leave blank for templates.
# Example (local Ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:120b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=12000

# Budget guards
MAX_RENDERS_PER_RETURN=3
UNIT_FLOOR=25
# Set on a hosted demo to cap daily spend (0 = off)
DAILY_UNIT_CAP=0
RATE_LIMIT_PER_MIN=60

# Opt-in: cache tone results + renders on disk keyed by the photo's SHA-256, so repeated
# demo takes with YOUR OWN photo don't spend units. Off by default (privacy).
DEMO_CACHE=0

# Server
PORT=3000
HOST=127.0.0.1
SESSION_TTL_MIN=20
# 0 = keep live dashboard events in memory only (no data/events.jsonl)
PERSIST_EVENTS=1
# Optional: when set, POST /api/integrations/return-started requires the header
# X-MirrorMatch-Secret with this value (see docs/INTEGRATION.md)
WEBHOOK_SECRET=

# Advanced (defaults verified against the live API on 2026-11-02)
# mcp (default): AI tasks go through YouCam's hosted MCP servers, with REST fallback.
# rest: call the REST task endpoints directly.
# YOUCAM_TRANSPORT=mcp
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_CLOTH_FEATURE=cloth-v4
# YOUCAM_GARMENT_CATEGORY=full_body
# YOUCAM_FACE_STRICTNESS=medium
